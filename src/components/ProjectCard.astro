---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const { title, summary, year, tags, cover, coverAlt } = project.data;
// Placeholder covers use a gradient until a real image is added.
const hues = [18, 200, 140, 280, 40, 330];
const hue = hues[index % hues.length];
---
<a class="card" href={`/projects/${project.id}/`}>
  <div class="media" style={`--h:${hue}`}>
    {cover
      ? <Image src={cover} alt={coverAlt ?? title} widths={[480, 800, 1200]} sizes="(min-width: 800px) 50vw, 100vw" />
      : <span class="ph serif" aria-hidden="true">{title}</span>}
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <span class="year">{year}</span>
  </div>
  <p>{summary}</p>
  <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .media {
    aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; position: relative;
    background:
      radial-gradient(120% 120% at 0% 0%, hsl(var(--h) 80% 62%), transparent 60%),
      radial-gradient(120% 120% at 100% 100%, hsl(calc(var(--h) + 50) 70% 45%), transparent 60%),
      var(--surface);
  }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .card:hover .media :global(img), .card:hover .ph { transform: scale(1.04); }
  .ph {
    position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 1rem;
    font-size: clamp(2rem, 4vw, 3rem); color: rgb(255 255 255 / 0.9); transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1rem; }
  h3 { margin: 0; font-size: 1.2rem; font-weight: 600; }
  .card:hover h3 { color: var(--accent); }
  .year { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  p { margin: 0.35rem 0 0.75rem; color: var(--muted); }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
  .tags li { font-size: 0.78rem; border: 1px solid var(--line); border-radius: 999px; padding: 0.15rem 0.6rem; color: var(--muted); }
</style>
