---
import { site } from '../data/site';
const links = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">N</span>
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <a class="cta" href="/contact/">Contact</a>
      <button class="theme" type="button" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3Zm0 16V5a7 7 0 0 1 0 14Z"/></svg>
      </button>
      <button class="menu" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M3 7h18v2H3zM3 15h18v2H3z"/></svg>
      </button>
    </nav>
  </div>
  <div id="mobile-nav" class="mobile" hidden>
    <ul class="wrap">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  const panel = document.getElementById('mobile-nav');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>

<style>
  .header { position: relative; z-index: 5; background: var(--bg);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; font-weight: 650; letter-spacing: -0.02em; }
  .mark { width: 2.25rem; height: 2.25rem; border-radius: 10px; background: var(--text); color: var(--bg); display: grid; place-items: center; font-weight: 700; }
  nav { display: flex; align-items: center; gap: 0.5rem; }
  .links { display: flex; list-style: none; margin: 0 0.75rem 0 0; padding: 0; gap: 0.25rem; }
  .links a { font-size: 0.95rem; font-weight: 500; color: var(--muted); padding: 0.5rem 0.8rem;
    text-decoration: underline 2px transparent; text-underline-offset: 0.45em; transition: color 0.15s, text-decoration-color 0.15s; }
  .links a[aria-current='page'] { color: var(--text); text-decoration-color: var(--accent); }
  .links a:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .mobile a:hover { color: var(--accent); }
  .cta { text-decoration: none; font-size: 0.95rem; font-weight: 600; background: var(--text); color: var(--bg); padding: 0.55rem 1.1rem; border-radius: 999px; }
  .cta:hover { background: var(--accent); color: #fff; }
  .theme, .menu { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line); background: none; color: var(--text); cursor: pointer; }
  .menu { display: none; }
  @media (max-width: 820px) {
    .links, .name { display: none; }
    .menu { display: grid; }
  }
  .mobile { border-top: 1px solid var(--line); background: var(--bg); }
  .mobile ul { list-style: none; padding-top: 0.5rem; padding-bottom: 1rem; margin: 0; }
  .mobile a { display: block; padding: 0.85rem 0; font-size: 1.25rem; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  @media (min-width: 821px) { .mobile { display: none !important; } }
</style>
