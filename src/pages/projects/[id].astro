---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCta from '../../components/ContactCta.astro';
import { disciplines } from '../../data/site';
import { getProjects, readingMinutes, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; next: Project; }
const { project, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const isCaseStudy = d.depth === 'case-study';
// The cover is shown at the top, so skip it in the gallery.
const items = d.gallery.filter((g) => !(d.cover && g.src && g.src.src === d.cover.src));
const gallery = await Promise.all(
  items.map(async (g) => ({ ...g, full: g.src ? (await getImage({ src: g.src, width: Math.min(g.src.width, 1800) })).src : undefined })),
);
const toc = headings.filter((h) => h.depth === 2);
const facts = [
  ['Client', d.client],
  ['Years', d.years !== 'TBD' ? d.years : undefined],
  ['Role', d.role],
  ['Team', d.team],
  ['Discipline', disciplines[d.discipline]],
].filter(([, v]) => v) as [string, string][];
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="wrap head">
      <a class="back" href="/work/">← All work</a>
      <p class="eyebrow">{isCaseStudy ? `Case study · Research + design · ${readingMinutes(project.body)} min read` : disciplines[d.discipline]}</p>
      <h1 class="serif">{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        {d.link && <div><dt>Live</dt><dd><a href={d.link} target="_blank" rel="noopener">Visit ↗</a></dd></div>}
      </dl>
      {d.outcome && <p class="outcome"><strong>Outcome</strong> {d.outcome}</p>}
    </header>

    {d.cover && <div class="wrap"><Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1200, 1800]} sizes="(min-width: 1200px) 1200px, 100vw" loading="eager" /></div>}

    <div class:list={['wrap', 'body', { 'with-toc': isCaseStudy && toc.length > 2 }]}>
      {isCaseStudy && toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><Content /></div>
    </div>

    {gallery.length > 0 && (
      <section class="wrap gallery-wrap" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="serif">{isCaseStudy ? 'Process and screens' : 'Gallery'}</h2>
        <div class="gallery">
          {gallery.map((g) => (
            <figure>
              {g.video
                ? <video src={g.video} autoplay muted loop playsinline aria-label={g.alt}></video>
                : <a href={g.full} class="zoom" data-caption={g.caption ?? ''} aria-label={`View larger: ${g.alt}`}>
                    <Image src={g.src!} alt={g.alt} widths={[500, 900]} sizes="(min-width: 800px) 50vw, 100vw" />
                  </a>}
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>

  <a class="next wrap" href={`/projects/${next.id}/`}>
    <span class="eyebrow">Next project</span>
    <span class="serif">{next.data.title} →</span>
  </a>
  <ContactCta />

  <dialog class="viewer" aria-label="Image viewer">
    <img alt="" />
    <p class="viewer-caption"></p>
    <button type="button" class="vbtn v-close" aria-label="Close">✕</button>
    <button type="button" class="vbtn v-prev" aria-label="Previous image">←</button>
    <button type="button" class="vbtn v-next" aria-label="Next image">→</button>
  </dialog>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a.zoom')];
  const dialog = document.querySelector<HTMLDialogElement>('dialog.viewer');
  if (dialog && links.length) {
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector<HTMLElement>('.viewer-caption')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      cap.textContent = a.dataset.caption || '';
    };
    links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); show(n); dialog.showModal(); }));
    dialog.querySelector(".v-close")!.addEventListener('click', () => dialog.close());
    dialog.querySelector(".v-prev")!.addEventListener('click', () => show(i - 1));
    dialog.querySelector(".v-next")!.addEventListener('click', () => show(i + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    dialog.addEventListener('close', () => links[i]?.focus());
  }
</script>

<style>
  .head { padding-top: 2.5rem; }
  .back { font-size: 0.9rem; color: var(--muted); text-decoration: none; display: inline-block; margin-bottom: 2rem; }
  h1 { font-size: clamp(2.75rem, 8vw, 6rem); line-height: 0.98; margin: 0 0 1rem; font-weight: 400; max-width: 18ch; }
  .summary { font-size: clamp(1.15rem, 2vw, 1.4rem); color: var(--muted); max-width: 52ch; margin: 0 0 2.5rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 1.25rem 3rem; margin: 0; padding: 1.5rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .facts dd { margin: 0.25rem 0 0; }
  .outcome { margin: 1.5rem 0 0; font-size: 1.1rem; max-width: 60ch; }
  .outcome strong { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .cover { width: 100%; max-height: 80vh; object-fit: contain; border-radius: 16px; margin-top: 3rem; background: var(--surface); }
  .body { padding-top: 3rem; padding-bottom: 5rem; }
  .with-toc { display: grid; gap: 3rem; }
  @media (min-width: 960px) {
    .with-toc { grid-template-columns: 220px 1fr; }
    .toc { position: sticky; top: 6rem; align-self: start; }
  }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem; }
  .toc a { text-decoration: none; color: var(--muted); }
  .toc a:hover { color: var(--accent); }
  @media (max-width: 959px) { .toc ol { flex-direction: row; flex-wrap: wrap; gap: 0.5rem 1rem; } }
  .gallery-wrap { padding-bottom: 5rem; }
  .gallery-wrap h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; margin: 0 0 2rem; }
  .gallery { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 800px) { .gallery { grid-template-columns: 1fr 1fr; } }
  .gallery figure { margin: 0; }
  .gallery :global(img), .gallery video { border-radius: 12px; width: 100%; display: block; background: var(--surface); }
  .zoom { display: block; cursor: zoom-in; }
  .viewer { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .viewer::backdrop { background: rgb(0 0 0 / 0.9); }
  .viewer[open] { display: grid; place-items: center; grid-template-rows: 1fr auto; }
  .viewer img { max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: 8px; }
  .viewer-caption { color: #eee; margin: 0.75rem 0 1.5rem; text-align: center; padding: 0 1rem; }
  .vbtn { position: fixed; background: rgb(255 255 255 / 0.12); color: #fff; border: 0; border-radius: 999px; width: 48px; height: 48px; font-size: 1.25rem; cursor: pointer; }
  .vbtn:hover { background: rgb(255 255 255 / 0.25); }
  .v-close { top: 1rem; right: 1rem; }
  .v-prev { left: 1rem; top: 50%; }
  .v-next { right: 1rem; top: 50%; }
  .gallery figcaption { font-size: 0.9rem; color: var(--muted); margin-top: 0.6rem; }
  .next { display: block; padding-top: 3rem; padding-bottom: 4rem; border-top: 1px solid var(--line); text-decoration: none; }
  .next .serif { display: block; font-size: clamp(2rem, 6vw, 4rem); line-height: 1; }
</style>
