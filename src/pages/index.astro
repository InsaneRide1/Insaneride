---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/projects';
import portrait from '../assets/portrait-hero.jpg';

const projects = await getProjects();
const caseStudies = projects.filter((p) => p.data.depth === 'case-study');
const byId = (id: string) => projects.find((p) => p.id === id)!;
const more = projects.filter((p) => p.data.depth !== 'case-study' && p.data.discipline !== 'ux');
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="photo">
        <Image src={portrait} alt={`Portrait of ${site.name}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 90vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="copy">
        <h1>
          <svg class="spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5c.6 4.9 2.6 7.9 9 10.5-6.4 2.6-8.4 5.6-9 10.5-.6-4.9-2.6-7.9-9-10.5 6.4-2.6 8.4-5.6 9-10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          Clarity-Driven Design <span class="mark-word">Leadership<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14c40-6 90-8 150-6s100 4 142 1M18 19c50-5 120-6 190-3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="lede">{site.name} turns ambiguous, complex requests into clear decisions, actionable plans and beautifully designed experiences.</p>
        <div class="cta">
          <a class="button primary" href="#case-studies">Case studies <span aria-hidden="true">↓</span></a>
          <a class="button" href="/about/">About me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section stats">
    <div class="wrap">
      <ul class="stats-row">
        <li><strong>25+</strong><span>Years of design experience</span></li>
        <li><strong>{caseStudies.length}</strong><span>In-depth UX case studies</span></li>
        <li><strong>6</strong><span>National retailers carrying my packaging</span></li>
        <li><strong>1</strong><span>New York Times bestseller cover</span></li>
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner reveal">
      <h2>Clear decisions. Actionable plans. Beautiful experiences.</h2>
      <a class="button" href="/about/">About me</a>
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>UX Case Studies</h2>
          <p>The research, decisions and design behind the products.</p>
        </div>
        <a class="link-arrow" href="/case-studies/">All case studies</a>
      </div>
      <div class="cs-list">
        {caseStudies.map((p, i) => <CaseStudyCard project={p} reverse={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Testimonials</h2>
          <p>What product leaders and collaborators say about working together.</p>
        </div>
        <a class="link-arrow" href="/about/#testimonials">More on About</a>
      </div>
      <Testimonials />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Beyond the screen</h2>
          <p>Packaging, print, illustration and brand work.</p>
        </div>
        <a class="link-arrow" href="/work/">All work</a>
      </div>
      <div class="grid three">
        {more.slice(0, 6).map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section alt" id="contact">
    <div class="wrap contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Let's work together.</h2>
        <p class="muted">Have a project, a role or a question? Send a note and I'll get back to you within two business days.</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(1rem, 3vw, 2rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1fr 1.05fr; gap: 3.5rem; } }
  .photo { position: relative; max-width: 560px; margin: 0 auto; width: 100%; }
  /* Fade the photo's edges and bottom into the page background */
  .photo :global(img) { width: 100%; height: auto;
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%), linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, #000 70%, transparent 100%), linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-composite: intersect; }
  :global([data-theme='dark']) .photo :global(img) { filter: brightness(0.92); }
  .copy { padding-bottom: clamp(2rem, 6vw, 4rem); }
  h1 { position: relative; font-size: clamp(2.6rem, 5.6vw, 4.75rem); line-height: 1.02; margin: 0 0 1.75rem; max-width: 13ch; }
  .spark { position: absolute; left: -1.6rem; top: -0.4rem; width: 1.6rem; height: 1.6rem; color: var(--accent); }
  @media (max-width: 1260px) { .spark { left: -0.2rem; top: -1.9rem; } }
  .mark-word { position: relative; white-space: nowrap; }
  .mark-word svg { position: absolute; left: -4%; right: -4%; width: 108%; bottom: -0.32em; height: 0.32em; color: var(--accent); }
  .lede { font-size: clamp(1.15rem, 1.9vw, 1.4rem); line-height: 1.5; color: var(--muted); max-width: 34ch; margin: 0 0 2.25rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  @media (max-width: 899px) { .photo { max-width: 360px; } .copy { text-align: left; } }
  .stats { padding-top: 0; }
  .band { background: var(--text); color: var(--bg); padding: clamp(4rem, 9vw, 7rem) 0; }
  .band-inner { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .band h2 { font-size: clamp(2rem, 5vw, 3.75rem); margin: 0; max-width: 18ch; }
  .band .button { background: transparent; color: var(--bg); border-color: color-mix(in srgb, var(--bg) 40%, transparent); }
  .band .button:hover { background: var(--bg); color: var(--text); }
  .cs-list { display: flex; flex-direction: column; gap: clamp(4rem, 9vw, 7rem); }
  .contact { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .contact { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .contact h2 { font-size: clamp(2.25rem, 5vw, 3.75rem); margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 1.1rem; max-width: 40ch; }
  .section.alt :global(.form) { background: var(--bg); }
</style>
