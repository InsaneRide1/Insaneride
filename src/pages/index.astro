---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactCta from '../components/ContactCta.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import portrait from '../assets/portrait.png';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const caseStudies = projects.filter((p) => p.data.depth === 'case-study');
const more = projects.filter((p) => p.data.depth !== 'case-study').slice(0, 3);
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
    {site.available && <p class="status"><span class="dot"></span>Open to new opportunities</p>}
    <h1 class="serif">{site.name}, <em>{site.title.toLowerCase()}</em>.</h1>
    <p class="lede">{site.intro}</p>
    <div class="cta">
      <a class="button primary" href="/work/">See the work</a>
      <a class="button" href="/contact/">Get in touch</a>
    </div>
    </div>
    {site.hasPortrait && <div class="hero-photo"><Image src={portrait} alt={`Portrait of ${site.name}`} widths={[400, 700, 900]} sizes="(min-width: 900px) 35vw, 0px" loading="eager" /></div>}
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>In-depth case studies</h2>
        <span class="eyebrow">Research + design</span>
      </div>
      <div class="grid three">
        {caseStudies.map((p) => <ProjectCard project={p} large />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>More work</h2>
        <a class="eyebrow" href="/work/">All {projects.length} projects →</a>
      </div>
      <div class="grid three">
        {more.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Kind words</h2><a class="eyebrow" href="/about/#testimonials">More →</a></div>
      <Testimonials limit={3} />
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  .hero { padding-top: clamp(4rem, 12vw, 9rem); padding-bottom: clamp(4rem, 10vw, 7rem); display: grid; gap: 2rem; align-items: end; }
  .hero-photo { display: none; }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.6fr 1fr; padding-bottom: 0; }
    .hero-photo { display: block; align-self: end; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 200px 200px 0 0;
      background: radial-gradient(90% 70% at 50% 40%, hsl(18 85% 62% / 0.55), transparent 70%), var(--surface); }
    .hero-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; padding-top: 2rem; }
  }
  .status { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; color: var(--muted); margin: 0 0 2rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #2fbf71; box-shadow: 0 0 0 4px color-mix(in srgb, #2fbf71 25%, transparent); }
  h1 { font-size: clamp(2.75rem, 8vw, 6.5rem); line-height: 0.98; letter-spacing: -0.01em; margin: 0; max-width: 13ch; }
  h1 em { color: var(--accent); }
  .lede { font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--muted); max-width: 46ch; margin: 2rem 0 2.5rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  a.eyebrow { text-decoration: none; }
</style>
