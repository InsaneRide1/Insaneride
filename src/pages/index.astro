---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/projects';
import portrait from '../assets/portrait.png';

const projects = await getProjects();
const caseStudies = projects.filter((p) => p.data.depth === 'case-study');
const byId = (id: string) => projects.find((p) => p.id === id)!;
// Photo strip: portrait plus three pieces of work, cropped into rounded tiles.
const strip = ['infusionsoft-marketplace', 'brand-print', 'cultbjj'].map(byId);
const more = projects.filter((p) => p.data.depth !== 'case-study' && p.data.discipline !== 'ux');
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="strip" aria-hidden="true">
        <div class="tile portrait"><Image src={portrait} alt="" widths={[300, 500]} sizes="25vw" loading="eager" /></div>
        {strip.map((p) => p.data.cover && <div class="tile"><Image src={p.data.cover} alt="" widths={[300, 600]} sizes="25vw" loading="eager" /></div>)}
      </div>
      <p class="eyebrow">{site.name} · {site.title}</p>
      <h1>Designing for a human experience.</h1>
      <p class="lede">{site.intro} Over 25 years leading UX, product and brand design, from research to the final pixel.</p>
      <div class="cta">
        <a class="button primary" href="/case-studies/">Case studies</a>
        <a class="button" href="/about/">About me</a>
      </div>
    </div>
  </section>

  <section class="section stats">
    <div class="wrap">
      <ul class="stats-row">
        <li><strong>25+</strong><span>Years of design experience</span></li>
        <li><strong>{caseStudies.length}</strong><span>In-depth UX case studies</span></li>
        <li><strong>6</strong><span>National retailers carrying my packaging</span></li>
        <li><strong>1</strong><span>New York Times bestseller cover</span></li>
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-inner reveal">
      <h2>Clear decisions. Actionable plans. Beautiful experiences.</h2>
      <a class="button" href="/about/">About me</a>
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>UX Case Studies</h2>
          <p>The research, decisions and design behind the products.</p>
        </div>
        <a class="link-arrow" href="/case-studies/">All case studies</a>
      </div>
      <div class="cs-list">
        {caseStudies.map((p, i) => <CaseStudyCard project={p} reverse={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Testimonials</h2>
          <p>What product leaders and collaborators say about working together.</p>
        </div>
        <a class="link-arrow" href="/about/#testimonials">More on About</a>
      </div>
      <Testimonials />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Beyond the screen</h2>
          <p>Packaging, print, illustration and brand work.</p>
        </div>
        <a class="link-arrow" href="/work/">All work</a>
      </div>
      <div class="grid three">
        {more.slice(0, 6).map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section alt" id="contact">
    <div class="wrap contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Let's work together.</h2>
        <p class="muted">Have a project, a role or a question? Send a note and I'll get back to you within two business days.</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: clamp(3rem, 7vw, 5rem); }
  .strip { display: grid; grid-template-columns: 1.1fr 1.6fr 1fr 1fr; gap: clamp(0.5rem, 1.5vw, 1rem); margin-bottom: clamp(2.5rem, 6vw, 4.5rem); height: clamp(180px, 28vw, 380px); }
  .tile { border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .portrait { background: radial-gradient(90% 70% at 50% 40%, hsl(18 85% 62% / 0.5), transparent 70%), var(--surface); }
  .portrait :global(img) { padding-top: 0.75rem; }
  @media (max-width: 640px) { .strip { grid-template-columns: 1.2fr 1fr; height: 300px; } .strip .tile:nth-child(n+3) { display: none; } }
  h1 { font-size: clamp(2.75rem, 7.5vw, 6rem); line-height: 1; margin: 0 0 1.5rem; max-width: 15ch; }
  .lede { font-size: clamp(1.15rem, 2vw, 1.4rem); color: var(--muted); max-width: 52ch; margin: 0 0 2.25rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .stats { padding-top: 0; }
  .band { background: var(--text); color: var(--bg); padding: clamp(4rem, 9vw, 7rem) 0; }
  .band-inner { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .band h2 { font-size: clamp(2rem, 5vw, 3.75rem); margin: 0; max-width: 18ch; }
  .band .button { background: transparent; color: var(--bg); border-color: color-mix(in srgb, var(--bg) 40%, transparent); }
  .band .button:hover { background: var(--bg); color: var(--text); }
  .cs-list { display: flex; flex-direction: column; gap: clamp(4rem, 9vw, 7rem); }
  .contact { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .contact { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .contact h2 { font-size: clamp(2.25rem, 5vw, 3.75rem); margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 1.1rem; max-width: 40ch; }
  .section.alt :global(.form) { background: var(--bg); }
</style>
